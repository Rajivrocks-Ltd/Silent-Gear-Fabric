classTweaker	v1	official
# Silent Gear (Fabric port). Access changes that NeoForge provides through its own access
# transformer, which upstream relies on. One line per member, with the upstream user noted.

# GearSickleItem, IAoeTool: drop experience for blocks broken by area tools
accessible	method	net/minecraft/world/level/block/Block	popExperience	(Lnet/minecraft/server/level/ServerLevel;Lnet/minecraft/core/BlockPos;I)V

# ModContainerBlock, AlloyMakerBlock, StarlightChargerBlock, SgBlockEntities: block entity factories
accessible	class	net/minecraft/world/level/block/entity/BlockEntityType$BlockEntitySupplier
# SgBlockEntities: NeoForge makes this constructor public
accessible	method	net/minecraft/world/level/block/entity/BlockEntityType	<init>	(Lnet/minecraft/world/level/block/entity/BlockEntityType$BlockEntitySupplier;Ljava/util/Set;)V
# IngredientUtils: NeoForge adds Ingredient.getValues()
accessible	field	net/minecraft/world/item/crafting/Ingredient	values	Lnet/minecraft/core/HolderSet;
# KeyTracker: NeoForge adds AbstractContainerScreen.getSlotUnderMouse()
accessible	field	net/minecraft/client/gui/screens/inventory/AbstractContainerScreen	hoveredSlot	Lnet/minecraft/world/inventory/Slot;

# Data generators (M10). ModItemModelProvider, GearItemModelBuilder: untinted first layer
accessible	field	net/minecraft/client/data/models/ItemModelGenerators	BLANK_LAYER	Lnet/minecraft/client/color/item/ItemTintSource;
# ModItemModelProvider: item model templates with more layers
accessible	method	net/minecraft/client/data/models/model/ModelTemplates	createItem	(Ljava/lang/String;[Lnet/minecraft/client/data/models/model/TextureSlot;)Lnet/minecraft/client/data/models/model/ModelTemplate;
# ModBlockModelGenerator: rotated block states
accessible	field	net/minecraft/client/data/models/BlockModelGenerators	ROTATION_HORIZONTAL_FACING	Lnet/minecraft/client/data/models/blockstates/PropertyDispatch;
# ModBlockLootTables: check only Silent Gear blocks for missing loot tables, as NeoForge's getKnownBlocks() does
accessible	field	net/minecraft/data/loot/BlockLootSubProvider	map	Ljava/util/Map;
accessible	field	net/minecraft/data/loot/BlockLootSubProvider	enabledFeatures	Lnet/minecraft/world/flag/FeatureFlagSet;
